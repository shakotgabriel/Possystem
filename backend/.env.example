# Backend configuration

# Required (used by JWT auth strategy)
JWT_SECRET=replace-with-a-long-random-string

# Server
HOST=127.0.0.1
PORT=8000
API_PREFIX=

# CORS (optional). If set, overrides default allowed origins.
FRONTEND_URL=http://localhost:5173

# Database
# Default is sqljs (embedded sqlite-like DB stored on disk)
DB_TYPE=sqljs
DB_PATH=./data/pos.sqlite

# If using Postgres instead:
# DB_TYPE=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# TypeORM
TYPEORM_LOGGING=false

# Optional: override where the backend looks for the built web app (Vite dist)
WEB_DIST_DIR=
